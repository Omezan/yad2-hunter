TELEGRAM_BOT_TOKEN=replace-with-your-new-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
TELEGRAM_NOTIFICATIONS_ENABLED=true
PLAYWRIGHT_HEADLESS=true
SEARCH_TIMEOUT_MS=60000
ENABLED_SEARCH_IDS=
STATE_DIR=state
HISTORY_LIMIT=50
SEEN_RETENTION_DAYS=30

# SMTP transport for the Lev HaPark watch (notifyVia: 'email' searches).
# When any required SMTP var is missing, the email service skips
# gracefully and the rest of the run still succeeds. For Gmail use an
# App Password (https://myaccount.google.com/apppasswords).
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Yad2 Hunter <you@example.com>
EMAIL_RECIPIENTS=ohadmezan@gmail.com
